---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Tile from '../components/Tile.astro';
import VideoOverlay from '../components/VideoOverlay.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const reelEntry = await getEntry('reel', 'reel');
const reel = reelEntry.data;

const aboutEntry = await getEntry('about', 'about');
const about = aboutEntry.data;

const REEL_LOOP = reel.loop;
const REEL_FULL = reel.vimeoUrl;
const REEL_POSTER = reel.poster;
---
<Base title="Orges Kokoshari — 3D / VFX">
  <Header transparent />

  <div class="hero" id="hero">
    <img class="hp" src={REEL_POSTER} alt="" />
    <div class="gaze" id="gaze">
      <video class="gz on" id="gzA" muted loop playsinline preload="auto" poster={REEL_POSTER}>
        <source src={REEL_LOOP} type="video/mp4" />
      </video>
      <video class="gz" id="gzB" muted playsinline preload="none"></video>
    </div>
    <div class="scrim"></div>
    <div class="hero-in">
      <div>
        <h1>Orges<br />Kokoshari</h1>
        <div class="tag">{reel.tagline}</div>
      </div>
      <div>
        <button class="play" id="playReel" data-video-trigger="reel">&#9654;&nbsp; Play reel</button>
        <div class="reelmeta">Showreel</div>
      </div>
    </div>
    <div class="cue"></div>
  </div>

  <main class="wrap">
    <section id="work">
      <div class="sec-head">
        <h2>Selected Work</h2>
        <a class="arrow" href="/work/">All work &rarr;</a>
      </div>
      <div class="grid">{featured.map((p) => <Tile project={p} />)}</div>
    </section>

    <section id="about">
      <div class="intro">
        <p class="lede">{about.lede}</p>
        <div>
          <p class="small">Twenty years building CG assets end to end — sculpt through look-dev, lighting, and animation — with credits on Extraction II, One Piece, and Godless.</p>
          <a class="arrow" href="/about/">More about me &rarr;</a>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="cta">
        <div class="mono" style="margin-bottom:20px">Available for freelance and staff roles</div>
        <a class="mail" href="mailto:orgesk@gmail.com">orgesk@gmail.com</a>
        <div class="slinks">
          <a href="https://www.linkedin.com/in/orgeskokoshari/">LinkedIn &nearr;</a>
          <a href="/orges-kokoshari-cv.pdf" download>CV &darr;</a>
        </div>
      </div>
    </section>
  </main>

  <VideoOverlay id="reel" vimeoUrl={REEL_FULL} label="Showreel" />
</Base>

<style>
.hero{position:relative;background:#000;overflow:hidden}
.hero img.hp{width:100%;height:100%;object-fit:contain;position:absolute;inset:0}
.hero .gaze{position:absolute;inset:0;opacity:0;transition:opacity .9s ease}
.hero.ready .gaze{opacity:1}
.gz{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .2s ease}
.gz.on{opacity:1}
.scrim{position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(to top,rgba(0,0,0,.88) 0%,rgba(0,0,0,.3) 26%,rgba(0,0,0,0) 52%)}
.hero-in{position:absolute;left:0;right:0;bottom:0;z-index:4;
  padding:0 clamp(16px,4.5vw,68px) clamp(26px,4vw,54px);
  display:flex;justify-content:space-between;align-items:flex-end;gap:26px;flex-wrap:wrap}
.hero h1{font-size:clamp(30px,7.2vw,104px);font-variation-settings:"wdth" 120,"wght" 800;line-height:.86}
.tag{font-family:var(--mono);font-size:clamp(9px,1.1vw,11px);letter-spacing:.22em;text-transform:uppercase;color:var(--dim);margin-top:14px}
.reelmeta{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dimmer);margin-top:12px;text-align:right}
.cue{position:absolute;left:50%;bottom:0;z-index:4;width:1px;height:46px;background:linear-gradient(to bottom,transparent,var(--dim))}
@media(prefers-reduced-motion:no-preference){.cue{animation:cue 2.6s ease-in-out infinite}}
@keyframes cue{0%,100%{opacity:.25;transform:scaleY(.6);transform-origin:bottom}50%{opacity:1;transform:scaleY(1)}}

.intro{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:start}
@media(max-width:820px){.intro{grid-template-columns:1fr}}
.lede{font-size:clamp(19px,2.6vw,30px);line-height:1.35;margin:0;letter-spacing:-.008em}
.small{margin:0 0 16px;color:var(--dim);max-width:56ch}
.cta{border-top:1px solid var(--line);padding-top:clamp(38px,6vw,70px)}
.mail{font-family:var(--display);font-variation-settings:"wdth" 100,"wght" 640;font-weight:600;
  font-size:clamp(20px,4.6vw,56px);letter-spacing:-.012em;line-height:1.05;display:inline-block;
  border-bottom:1px solid var(--line);padding-bottom:8px;transition:border-color .25s;word-break:break-word}
.mail:hover{border-color:var(--milk)}
.slinks{display:flex;gap:20px;flex-wrap:wrap;margin-top:34px}
.slinks a{font-family:var(--mono);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--dim);transition:color .2s}
.slinks a:hover{color:var(--milk)}
</style>

<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const hero = document.getElementById('hero') as HTMLElement;
const gzA = document.getElementById('gzA') as HTMLVideoElement;
const gzB = document.getElementById('gzB') as HTMLVideoElement;

function fitHero() {
  hero.style.height = Math.round(Math.min((hero.clientWidth * 9) / 16, window.innerHeight - 52)) + 'px';
}
window.addEventListener('resize', fitHero);
fitHero();

if (!reduce) {
  gzA.addEventListener('playing', () => hero.classList.add('ready'), { once: true });
  gzA.play().catch(() => {});
}

const hdr = document.getElementById('hdr')!;
new IntersectionObserver(
  (es) => hdr.classList.toggle('solid', !es[0].isIntersecting),
  { rootMargin: '-90% 0px 0px 0px' }
).observe(hero);

const IDLE_SRC = '/media/site/idle.mp4';
const GAZE: Record<string, { src: string; glance: number }> = {
  right:       { src: '/media/site/right.mp4',       glance: 50 },
  left:        { src: '/media/site/left.mp4',        glance: 50 },
  up:          { src: '/media/site/up.mp4',          glance: 50 },
  down:        { src: '/media/site/down.mp4',        glance: 50 },
  up_left:     { src: '/media/site/up_left.mp4',     glance: 60 },
  up_right:    { src: '/media/site/up_right.mp4',    glance: 57 },
  down_left:   { src: '/media/site/down_left.mp4',   glance: 46 },
  down_right:  { src: '/media/site/down_right.mp4',  glance: 70 }
};

let active: HTMLVideoElement = gzA;
let currentZone = 'rest';

function playFrom(video: HTMLVideoElement, src: string, startTime: number, loop: boolean) {
  const start = () => {
    try { video.currentTime = startTime; } catch {}
    video.loop = loop;
    video.play().catch(() => {});
  };
  if (video.dataset.src === src) {
    start();
  } else {
    video.dataset.src = src;
    video.src = src;
    video.load();
    video.addEventListener('loadedmetadata', start, { once: true });
  }
}

function showZone(zone: string) {
  if (zone === currentZone) return;
  currentZone = zone;
  const next = active === gzA ? gzB : gzA;
  const prev = active;
  const dir = GAZE[zone];
  if (dir) playFrom(next, dir.src, dir.glance / 30, false);
  else playFrom(next, IDLE_SRC, 0, true);
  next.classList.add('on');
  prev.classList.remove('on');
  active = next;
}

function zoneFor(x: number, y: number, w: number, h: number) {
  const col = x < w / 3 ? 0 : x < (2 * w) / 3 ? 1 : 2;
  const row = y < h / 3 ? 0 : y < (2 * h) / 3 ? 1 : 2;
  const rows = [
    ['up_left', 'up', 'up_right'],
    ['left', 'rest', 'right'],
    ['down_left', 'down', 'down_right']
  ];
  return rows[row][col];
}

if (!reduce && matchMedia('(hover: hover)').matches) {
  let pending = false;
  window.addEventListener('mousemove', (e) => {
    if (pending) return;
    pending = true;
    requestAnimationFrame(() => {
      pending = false;
      showZone(zoneFor(e.clientX, e.clientY, window.innerWidth, window.innerHeight));
    });
  });
  document.addEventListener('mouseleave', () => showZone('rest'));

  requestIdleCallback?.(() => {
    Object.values(GAZE).forEach((d) => {
      const pre = document.createElement('video');
      pre.muted = true;
      pre.preload = 'auto';
      pre.style.display = 'none';
      pre.src = d.src;
      document.body.appendChild(pre);
    });
  });
}

document.addEventListener('videooverlay:open', (e) => {
  if ((e as CustomEvent).detail.id !== 'reel') return;
  gzA.pause();
  gzB.pause();
});
document.addEventListener('videooverlay:close', (e) => {
  if ((e as CustomEvent).detail.id !== 'reel') return;
  if (!reduce) { currentZone = ''; showZone('rest'); }
});

document.querySelectorAll('.tile').forEach((t) => {
  const v = t.querySelector('video') as HTMLVideoElement | null;
  if (!v || reduce || !matchMedia('(hover: hover)').matches) return;
  t.addEventListener('mouseenter', () => {
    if (!v.src) v.src = v.dataset.src!;
    t.classList.add('playing');
    v.play().catch(() => {});
  });
  t.addEventListener('mouseleave', () => { t.classList.remove('playing'); v.pause(); });
});
</script>
