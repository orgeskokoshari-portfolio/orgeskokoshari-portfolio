---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Tile from '../components/Tile.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const REEL_LOOP = '/media/pilot-final.mp4';
const REEL_FULL = 'https://player.vimeo.com/video/000000000';
const REEL_POSTER = '/media/pilot-poster.jpg';
---
<Base title="Orges Kokoshari — 3D / VFX">
  <Header transparent />

  <div class="hero" id="hero">
    <img class="hp" src={REEL_POSTER} alt="" />
    <video id="loop" muted loop playsinline preload="auto" poster={REEL_POSTER}>
      <source src={REEL_LOOP} type="video/mp4" />
    </video>
    <div class="scrim"></div>
    <div class="hero-in">
      <div>
        <h1>Orges<br />Kokoshari</h1>
        <div class="tag">Creative 3D &amp; VFX &middot; Film, episodic, advertising</div>
      </div>
      <div>
        <button class="play" id="playReel">&#9654;&nbsp; Play reel</button>
        <div class="reelmeta">Showreel</div>
      </div>
    </div>
    <div class="cue"></div>
  </div>

  <main class="wrap">
    <section id="work">
      <div class="sec-head">
        <h2>Selected Work</h2>
        <a class="arrow" href="/work/">All work &rarr;</a>
      </div>
      <div class="grid">{featured.map((p) => <Tile project={p} />)}</div>
    </section>

    <section id="about">
      <div class="intro">
        <p class="lede">One sentence on what you do and who you do it for.</p>
        <div>
          <p class="small">Two or three short sentences expanding on it. Keep it under sixty words — the About page carries the long version.</p>
          <a class="arrow" href="/about/">More about me &rarr;</a>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="cta">
        <div class="mono" style="margin-bottom:20px">Available for freelance and staff roles</div>
        <a class="mail" href="mailto:kokosharstudios@gmail.com">kokosharstudios@gmail.com</a>
        <div class="slinks">
          <a href="https://www.linkedin.com/in/orgeskokoshari/">LinkedIn &nearr;</a>
          <a href="https://www.instagram.com/orges.kokoshari/">Instagram &nearr;</a>
          <a href="https://www.youtube.com/@kokosharistudios-digital">YouTube &nearr;</a>
          <a href="/orges-kokoshari-cv.pdf" download>CV &darr;</a>
        </div>
      </div>
    </section>
  </main>

  <div class="ov" id="ov" role="dialog" aria-modal="true" aria-label="Showreel">
    <button class="ovx" id="ovx" aria-label="Close reel">&#10005;</button>
    <div class="ovframe">
      <iframe id="vim" src="" title="Showreel" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen data-src={`${REEL_FULL}?autoplay=1&title=0&byline=0&portrait=0&dnt=1`}></iframe>
    </div>
  </div>
</Base>

<style>
.hero{position:relative;background:#000;overflow:hidden}
.hero video,.hero img.hp{width:100%;height:100%;object-fit:contain;position:absolute;inset:0}
.hero video{opacity:0;transition:opacity .9s ease}
.hero.ready video{opacity:1}
.scrim{position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(to top,rgba(0,0,0,.88) 0%,rgba(0,0,0,.3) 26%,rgba(0,0,0,0) 52%)}
.hero-in{position:absolute;left:0;right:0;bottom:0;z-index:4;
  padding:0 clamp(16px,4.5vw,68px) clamp(26px,4vw,54px);
  display:flex;justify-content:space-between;align-items:flex-end;gap:26px;flex-wrap:wrap}
.hero h1{font-size:clamp(30px,7.2vw,104px);font-variation-settings:"wdth" 120,"wght" 800;line-height:.86}
.tag{font-family:var(--mono);font-size:clamp(9px,1.1vw,11px);letter-spacing:.22em;text-transform:uppercase;color:var(--dim);margin-top:14px}
.play{display:inline-flex;align-items:center;gap:11px;font-family:var(--mono);font-size:10px;letter-spacing:.18em;
  text-transform:uppercase;color:var(--milk);border:1px solid rgba(230,231,226,.42);background:rgba(0,0,0,.35);
  backdrop-filter:blur(6px);padding:14px 22px;cursor:pointer;transition:.25s;white-space:nowrap}
.play:hover{border-color:var(--milk);background:rgba(230,231,226,.1)}
.reelmeta{font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--dimmer);margin-top:12px;text-align:right}
.cue{position:absolute;left:50%;bottom:0;z-index:4;width:1px;height:46px;background:linear-gradient(to bottom,transparent,var(--dim))}
@media(prefers-reduced-motion:no-preference){.cue{animation:cue 2.6s ease-in-out infinite}}
@keyframes cue{0%,100%{opacity:.25;transform:scaleY(.6);transform-origin:bottom}50%{opacity:1;transform:scaleY(1)}}

.intro{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,5vw,80px);align-items:start}
@media(max-width:820px){.intro{grid-template-columns:1fr}}
.lede{font-size:clamp(19px,2.6vw,30px);line-height:1.35;margin:0;letter-spacing:-.008em}
.small{margin:0 0 16px;color:var(--dim);max-width:56ch}
.cta{border-top:1px solid var(--line);padding-top:clamp(38px,6vw,70px)}
.mail{font-family:var(--display);font-variation-settings:"wdth" 100,"wght" 640;font-weight:600;
  font-size:clamp(20px,4.6vw,56px);letter-spacing:-.012em;line-height:1.05;display:inline-block;
  border-bottom:1px solid var(--line);padding-bottom:8px;transition:border-color .25s;word-break:break-word}
.mail:hover{border-color:var(--milk)}
.slinks{display:flex;gap:20px;flex-wrap:wrap;margin-top:34px}
.slinks a{font-family:var(--mono);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--dim);transition:color .2s}
.slinks a:hover{color:var(--milk)}

.ov{position:fixed;inset:0;z-index:800;background:rgba(6,7,7,.96);backdrop-filter:blur(20px);
  display:none;opacity:0;transition:opacity .35s;padding:clamp(14px,3vw,44px)}
.ov.open{display:flex;align-items:center;justify-content:center}
.ov.shown{opacity:1}
.ovframe{width:100%;max-width:1500px;aspect-ratio:16/9;background:#000}
.ovframe iframe{width:100%;height:100%;border:0}
.ovx{position:absolute;top:clamp(12px,2.4vw,28px);right:clamp(12px,2.4vw,28px);width:40px;height:40px;
  border:1px solid var(--line);background:none;color:var(--milk);cursor:pointer;font-size:15px;
  display:grid;place-items:center;transition:.22s;z-index:5}
.ovx:hover{border-color:var(--milk);rotate:90deg}
</style>

<script>
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const hero = document.getElementById('hero') as HTMLElement;
const loop = document.getElementById('loop') as HTMLVideoElement;

function fitHero() {
  hero.style.height = Math.round(Math.min((hero.clientWidth * 9) / 16, window.innerHeight - 52)) + 'px';
}
window.addEventListener('resize', fitHero);
fitHero();

if (!reduce) {
  loop.addEventListener('playing', () => hero.classList.add('ready'));
  loop.play().catch(() => {});
}

const hdr = document.getElementById('hdr')!;
new IntersectionObserver(
  (es) => hdr.classList.toggle('solid', !es[0].isIntersecting),
  { rootMargin: '-90% 0px 0px 0px' }
).observe(hero);

const ov = document.getElementById('ov')!;
const vim = document.getElementById('vim') as HTMLIFrameElement;
function openReel() {
  ov.classList.add('open');
  requestAnimationFrame(() => ov.classList.add('shown'));
  document.body.classList.add('locked');
  loop.pause();
  if (!vim.src) vim.src = vim.dataset.src!;
  (document.getElementById('ovx') as HTMLElement).focus();
}
function closeReel() {
  ov.classList.remove('shown');
  setTimeout(() => ov.classList.remove('open'), 340);
  document.body.classList.remove('locked');
  vim.src = '';
  if (!reduce) loop.play().catch(() => {});
}
document.getElementById('playReel')!.addEventListener('click', openReel);
document.getElementById('ovx')!.addEventListener('click', closeReel);
ov.addEventListener('click', (e) => { if (e.target === ov) closeReel(); });
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && ov.classList.contains('open')) closeReel();
});

document.querySelectorAll('.tile').forEach((t) => {
  const v = t.querySelector('video') as HTMLVideoElement | null;
  if (!v || reduce || !matchMedia('(hover: hover)').matches) return;
  t.addEventListener('mouseenter', () => {
    if (!v.src) v.src = v.dataset.src!;
    t.classList.add('playing');
    v.play().catch(() => {});
  });
  t.addEventListener('mouseleave', () => { t.classList.remove('playing'); v.pause(); });
});
</script>
