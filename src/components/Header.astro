---
const { transparent = false } = Astro.props;
---
<header id="hdr" class={transparent ? '' : 'solid'}>
  <a href="/"><b>Orges Kokoshari</b></a>
  <nav>
    <a href="/work/">Work</a>
    <a href="/about/">About</a>
    <a href="/about/#credits">Credits</a>
    <a href="/about/#contact">Contact</a>
  </nav>
</header>

<style>
header{position:fixed;top:0;left:0;right:0;height:var(--hdr);z-index:500;display:flex;align-items:center;
  justify-content:space-between;padding-inline:clamp(16px,4.5vw,68px);transition:background .4s,border-color .4s;
  border-bottom:1px solid transparent}
header.solid{background:rgba(20,22,21,.78);backdrop-filter:blur(14px);border-bottom-color:var(--line-soft)}
header b{font-family:var(--display);font-variation-settings:"wdth" 112,"wght" 700;font-weight:700;
  font-size:14px;letter-spacing:.13em;text-transform:uppercase}
nav{display:flex;gap:24px}
nav a{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);transition:color .2s}
nav a:hover{color:var(--milk)}
@media(max-width:520px){nav a:nth-child(2),nav a:nth-child(3){display:none}}
</style>
